{
    "name": "mythsox/mini_framework",
    "description": "Minimal plain-PHP MVC-style skeleton (FastRoute + Twig + PDO, no full-stack framework)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "nikic/fast-route": "^1.3",
        "twig/twig": "^3.0",
        "laminas/laminas-diactoros": "^2.26 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "authors": [
        {
            "name": "dani",
            "email": "mrhamdani0101@gmail.com"
        }
    ]
}
